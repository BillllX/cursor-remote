# Copy to /etc/cursor-remote/gateway.env (root:cursor-remote, mode 640).
# Do not commit the real file.
# 本文件只是模板，网关不会读它（线上由 systemd EnvironmentFile=/etc/cursor-remote/gateway.env 注入）。
# 变量的权威清单在 gateway/src/config.ts 的 ENV_SPECS；新增变量要在这里补一行，npm run check:env 会查。
# 注释行是可选项，等号后面是默认值或示例，不是真实值。

# ── Cursor ──
# 必填。https://cursor.com/dashboard/api 新建 User API Key
CURSOR_API_KEY=
# 默认模型，网页里还能再改
CURSOR_REMOTE_MODEL=composer-2.5
# 用量/计费接口地址
# CURSOR_API_ENDPOINT=https://api2.cursor.sh
# 默认 harness 路径：baseline=现状，plane=策略层。单条 prompt.policy 可覆盖
# CURSOR_REMOTE_POLICY=baseline

# ── 网关 ──
# 监听地址和端口
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8787
# 是否把非网关请求反代到本机网页；0/false/off/no 关闭
# GATEWAY_PROXY_WEB=1
# 被反代的网页地址
# CURSOR_REMOTE_WEB_ORIGIN=http://127.0.0.1:3000
# 日志级别：debug / info / warn / error
# GATEWAY_LOG_LEVEL=info
# 日志格式：text（默认，journalctl grep 用）/ json（每条一行 JSON）
# GATEWAY_LOG_FORMAT=text

# ── 租户与状态 ──
# 会话、检查点、shadow-git 的根目录。VPS 生产用 /var/lib/cursor-remote
# CURSOR_REMOTE_STATE_DIR=/var/lib/cursor-remote
# 多租户：/etc/cursor-remote/tenants.json（root:cursor-remote, mode 640）
# 每人一个 id + 独立 token。改 tenants.json 必须重启 gateway，会打断所有在跑的 Agent。
# CURSOR_REMOTE_TENANTS_FILE=/etc/cursor-remote/tenants.json
# 预览签名。没有则启动时从本机配置派生。
# CURSOR_REMOTE_MEDIA_SECRET=

# ── 单租户回退（没有 tenants.json 时）──
# 单租户口令；CURSOR_REMOTE_PASSWORD 是旧名，前者为空时才用
# CURSOR_REMOTE_TOKEN=
# CURSOR_REMOTE_PASSWORD=
# 单租户模式的显示名（客户端侧栏「名字 · 工作区」），缺省为 default
# CURSOR_REMOTE_NAME=BillXu
# 单租户工作区根目录，缺省 ~/Projects
# CURSOR_REMOTE_CWD=
# 单租户是否启用沙箱；0/false/off/no 关闭
# CURSOR_REMOTE_SANDBOX=1

# ── 检查点 git 身份 ──
# 作者：GIT_AUTHOR_* 优先，其次 CURSOR_REMOTE_GIT_*；提交者缺省同作者
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# CURSOR_REMOTE_GIT_NAME=cursor-remote
# CURSOR_REMOTE_GIT_EMAIL=cursor-remote@localhost
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# ── 对外预览 ──
# 每人一条对外预览路径：https://<下面这个主机名>/p/<id>/
# 用这台机器已经有证书的主机名。配好后跑 scripts/insert-nginx-publish.py。
# 工作台公开访问、常驻不停，挂了自动拉起，没有闲置回收的开关。
# JIEBO_PUBLISH_HOST=jiebo.aiagentswitcher.com
# JIEBO_PUBLISH_SCHEME=https
# 预览进程的端口范围和等待监听的毫秒数
# JIEBO_PUBLISH_PORT_MIN=20000
# JIEBO_PUBLISH_PORT_MAX=20999
# JIEBO_PUBLISH_LISTEN_MS=45000

# ── APNs 推送（不配则安静跳过）──
# APNS_TEAM_ID=
# APNS_KEY_ID=
# .p8 全文（换行写成 \n）或文件路径，二选一
# APNS_PRIVATE_KEY=
# APNS_PRIVATE_KEY_PATH=
# APNS_BUNDLE_ID=
# sandbox 或 production
# APNS_DEFAULT_ENV=production
# 仅测试用，生产不要设
# APNS_HOST_OVERRIDE=
