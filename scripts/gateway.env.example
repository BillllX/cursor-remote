# Copy to /etc/cursor-remote/gateway.env (root:cursor-remote, mode 640).
# Do not commit the real file.

CURSOR_API_KEY=
CURSOR_REMOTE_MODEL=composer-2.5

# 多租户：/etc/cursor-remote/tenants.json（root:cursor-remote, mode 640）
# 每人一个 id + 独立 token。改 tenants.json 必须重启 gateway，会打断所有在跑的 Agent。
# CURSOR_REMOTE_TENANTS_FILE=/etc/cursor-remote/tenants.json

# 预览签名。没有则启动时从本机配置派生。
# CURSOR_REMOTE_MEDIA_SECRET=

# 每人一条对外预览路径：https://<下面这个主机名>/p/<id>/
# 用这台机器已经有证书的主机名。配好后跑 scripts/insert-nginx-publish.py。
# JIEBO_PUBLISH_HOST=jiebo.aiagentswitcher.com
# 工作台公开访问、常驻不停，挂了自动拉起，没有闲置回收的开关。

# 没有 tenants.json 时的单租户回退口令
# CURSOR_REMOTE_TOKEN=
# 单租户模式的显示名（客户端侧栏「名字 · 工作区」），缺省为 default
# CURSOR_REMOTE_NAME=BillXu
