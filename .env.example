# 必填。打开 https://cursor.com/dashboard/api 新建 User API Key
CURSOR_API_KEY=

# 没有 tenants.json 时的单租户工作区。VPS 多租户后由 STATE_DIR/tenants/<id>/workspace 派生
CURSOR_REMOTE_CWD=/Users/billxuopenclaw/Projects

# 会话、检查点、shadow-git。VPS 生产用 /var/lib/cursor-remote
# CURSOR_REMOTE_STATE_DIR=

# 可选。多租户名单，本机可用仓库根目录 tenants.json
# CURSOR_REMOTE_TENANTS_FILE=

# 默认模型，网页里还能再改
CURSOR_REMOTE_MODEL=composer-2.5

# 没有 tenants.json 时必填。网页登录密码 / 单租户回退
CURSOR_REMOTE_TOKEN=

# 可选。媒体预览 HMAC。没有则启动时派生
# CURSOR_REMOTE_MEDIA_SECRET=

GATEWAY_PORT=8787
GATEWAY_HOST=127.0.0.1
NEXT_PUBLIC_GATEWAY_PORT=8787
